{
  "name": "editor-pdf-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:compile": "tsc electron/main.ts --outDir dist-electron --target es2022 --module esnext --moduleResolution node --allowSyntheticDefaultImports true --ignoreConfig --ignoreDeprecations 6.0 && node -e \"const fs = require('fs'); fs.copyFileSync('electron/preload.cjs', 'dist-electron/preload.cjs');\"",
    "electron:serve": "npm run electron:compile && cross-env NODE_ENV=development electron dist-electron/main.js",
    "electron:dev": "concurrently -k \"npm run dev\" \"npm run electron:serve\"",
    "electron:build": "npm run build && npm run electron:compile && electron-builder"
  },
  "build": {
    "appId": "com.pdfeditor.pro",
    "productName": "Editor PDF Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "lucide-react": "^1.18.0",
    "mupdf": "^1.27.0",
    "node-qpdf2": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
